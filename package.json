{
  "name": "health-tracker-app",
  "version": "1.0.0",
  "description": "MERN Stack Health Tracker App",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "install-deps": "npm install && cd server && npm install && cd ../client && npm install",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "react": "^19.1.0",
    "recharts": "^3.1.0"
  }
}
